generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model FinancialProfile {
  id           String   @id @default("personal")
  name         String   @default("Meu planejamento")
  birthDate    String?
  rules        Json     @default("{}")
  createdAt    DateTime @default(now())
}
model Account {
  id           String   @id @default(cuid())
  name         String
  kind         String   @unique
  opening      Decimal? @db.Decimal(18, 2)
  openingDate  String?
  outgoing     Movement[] @relation("origin")
  incoming     Movement[] @relation("destination")
  goals        FinancialGoal[]
}
model Category {
  id           String @id @default(cuid())
  name         String @unique
  items        BudgetItem[]
}
model BudgetItem {
  id           String @id @default(cuid())
  name         String
  kind         String
  amount       Decimal @db.Decimal(18, 2)
  startMonth   String
  endMonth     String?
  recurring    Boolean @default(true)
  dueDay       Int?
  fixed        Boolean @default(false)
  essential    Boolean?
  notes        String @default("")
  sourceKey    String? @unique
  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  overrides    BudgetOverride[]
  movements    Movement[]
  @@index([startMonth, endMonth])
}
model BudgetOverride {
  id           String @id @default(cuid())
  itemId       String
  month        String
  amount       Decimal? @db.Decimal(18, 2)
  skipped      Boolean @default(false)
  item         BudgetItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  @@unique([itemId, month])
}
model Movement {
  id            String @id @default(cuid())
  name          String
  kind          String
  amount        Decimal @db.Decimal(18, 2)
  date          String
  month         String
  originId      String?
  destinationId String?
  origin        Account? @relation("origin", fields: [originId], references: [id], onDelete: Restrict)
  destination   Account? @relation("destination", fields: [destinationId], references: [id], onDelete: Restrict)
  itemId        String?
  item          BudgetItem? @relation(fields: [itemId], references: [id], onDelete: Restrict)
  paymentKey    String? @unique
  voidedAt      DateTime?
  createdAt     DateTime @default(now())
  @@index([date])
}
model FinancialGoal {
  id            String @id @default(cuid())
  name          String
  description   String @default("")
  kind          String
  target        Decimal @db.Decimal(18, 2)
  initial       Decimal? @db.Decimal(18, 2)
  startDate     String
  deadline      String
  contribution  Decimal @db.Decimal(18, 2)
  accountId     String?
  account       Account? @relation(fields: [accountId], references: [id], onDelete: Restrict)
  sourceKey     String? @unique
}
model ProjectionScenario {
  id           String @id @default(cuid())
  name         String
  parameters   Json
  sourceKey    String? @unique
  updatedAt    DateTime @updatedAt
}
model ImportBatch {
  id           String @id @default(cuid())
  hash         String @unique
  filename     String
  data         Json
  createdAt    DateTime @default(now())
}
model AuditEvent {
  id           String @id @default(cuid())
  action       String
  data         Json
  createdAt    DateTime @default(now())
}
